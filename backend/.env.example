# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database
# Development (SQLite):
DATABASE_URL=sqlite:///ccms.db
# Handover / V2 (MySQL or MariaDB) — create empty DB first, then:
#   flask --app run.py db upgrade
#   flask --app run.py seed
#   flask --app run.py verify-db
# DATABASE_URL=mysql+pymysql://ccms:ccms_password@127.0.0.1:3306/ccms?charset=utf8mb4
# Optional live pytest: set the same URI as CCMS_MYSQL_URL and run
#   pytest tests/test_mysql.py -m mysql -q

# Application
APP_NAME=CCMS
COMPANY_DISPLAY_NAME=CCMS
CURRENCY_CODE=ZMW
CURRENCY_SYMBOL=K

# CORS — React Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development password reset: include token in API response (never enable in production)
DEV_EXPOSE_PASSWORD_RESET_TOKEN=true

# Uploads
MAX_CONTENT_LENGTH_MB=16
MAX_LOGO_MB=2
# Files are stored under backend/uploads/ for school/demo.
# Production can swap the storage root / adapter without changing domain services.
