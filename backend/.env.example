# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database
# Development (SQLite):
DATABASE_URL=sqlite:///ccms.db
# Production / V2 (MySQL example):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ccms

# Application
APP_NAME=CCMS
COMPANY_DISPLAY_NAME=CCMS
CURRENCY_CODE=ZMW
CURRENCY_SYMBOL=K

# CORS — React Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development password reset: include token in API response (never enable in production)
DEV_EXPOSE_PASSWORD_RESET_TOKEN=true

# Uploads
MAX_CONTENT_LENGTH_MB=16
